flowchart TB
  CAM["<b>Phone or fixed camera</b><br/>handheld is fine — 72 px of hand motion measured OK<br/><code>30 / 60 / 240 fps</code>"]

  subgraph ING["AWS · INGEST"]
    direction LR
    S3R[("S3<br/>raw clips")] --> LAM["Lambda<br/><code>s3:ObjectCreated</code>"] --> SQS["SQS<br/>job queue"]
  end

  subgraph CMP["AWS · EC2 c8g.2xlarge · Graviton4 — COOL AMI (OpenCV 5.0 + Arm KleidiCV)"]
    direction TB
    W["N single-threaded workers, one per vCPU<br/><small>phaseCorrelate does not parallelise internally,<br/>so throughput is process-level</small>"]
    subgraph CV["OpenCV 5 pipeline — the claimed core workload"]
      direction TB
      P1["<b>1 · Locate what is vibrating</b><br/><code>temporal high-pass → boxFilter energy + texture</code>"]
      P2["<b>2 · Sub-pixel displacement</b><br/><code>cv2.phaseCorrelate · createHanningWindow</code>"]
      P3["<b>3 · Reject correlation failures</b><br/><code>MAD + correlation response</code>"]
      P4["<b>4 · Cancel camera motion</b><br/><code>static-reference subtraction, adaptive</code>"]
      P5["<b>5 · Temporal spectrum</b><br/><code>Hann → cv2.dft → amplitude in px</code>"]
      P6["<b>6 · Shaft rate and fault</b><br/><code>harmonic comb → noise-floor gated 1×/2×/3×</code>"]
      P1 --> P2 --> P3 --> P4 --> P5 --> P6
    end
    W -.-> P1
  end

  subgraph ST["AWS · STATE"]
    direction LR
    DDB[("DynamoDB<br/>per-asset baselines")]
    S3E[("S3<br/>evidence + previews")]
    CW["CloudWatch<br/>decision trace"]
  end

  subgraph AG["DECIDE"]
    direction LR
    POL{{"Agent policy<br/><small>deterministic reference, no API key<br/>· or any MCP client</small>"}}
    TOOL["<code>assess_quality · estimate_shaft<br/>diagnose · compare_baseline</code>"]
    POL --> TOOL
  end

  VER{"Verdict"}
  UI["<b>Web endpoint</b><br/>FastAPI + SSE — live decision trace"]
  HUM["<b>Human</b><br/><small>escalated with evidence when<br/>confidence &lt; 0.55 — 18.8% of runs</small>"]

  CAM --> S3R
  SQS --> CV
  P6 --> DDB & S3E
  DDB --> POL
  TOOL --> VER
  TOOL -.-> CW
  VER -->|report| UI
  VER -->|escalate| HUM
  VER ==>|"<b>re-acquire</b> — the vision result changes<br/>what gets measured next"| CAM

  classDef aws fill:#fff7ed,stroke:#f59e0b,stroke-width:1.5px,color:#0f172a
  classDef cv  fill:#f0fdfa,stroke:#14b8a6,stroke-width:1.5px,color:#0f172a
  classDef ag  fill:#faf5ff,stroke:#a855f7,stroke-width:1.5px,color:#0f172a
  classDef pl  fill:#ffffff,stroke:#cbd5e1,color:#0f172a
  class S3R,LAM,SQS,DDB,S3E,CW aws
  class P1,P2,P3,P4,P5,P6,W cv
  class POL,TOOL,VER ag
  class CAM,UI,HUM pl
  style CMP fill:#fffbf5,stroke:#f59e0b,stroke-width:2px
  style CV  fill:#f6fffe,stroke:#14b8a6,stroke-width:2px
  style ING fill:#fffbf5,stroke:#fcd9a3
  style ST  fill:#fffbf5,stroke:#fcd9a3
  style AG  fill:#fdfaff,stroke:#e9d5ff
