flowchart TB
  CAM["Camera · 30 / 60 / 240 fps"]
  ING["AWS · Ingest — PLANNED<br/>S3 → Lambda → SQS"]
  subgraph CMP["OpenCV 5 · AWS Graviton4 + COOL — BUILT &amp; BENCHMARKED"]
    P1["Locate vibration · phaseCorrelate"]
    P2["Reject outliers · cancel camera motion"]
    P3["cv2.dft spectrum → harmonics → fault"]
    P1 --> P2 --> P3
  end
  ST["AWS · State — PLANNED<br/>DynamoDB baselines · S3 evidence · CloudWatch trace"]
  AG["Agent · deterministic policy or MCP<br/>OpenCV 5 tool surface"]
  VER{"Verdict"}
  TR["Decision trace — BUILT<br/>agent_trace.json · live SSE"]
  UI["Web endpoint"]
  HUM["Human · confidence &lt; 0.55"]
  CAM --> ING --> P1
  P3 --> AG --> VER
  AG --> TR
  P3 -.-> ST
  VER -->|report| UI
  VER -->|escalate| HUM
  VER ==>|re-acquire| CAM

  classDef aws fill:#fff7ed,stroke:#f59e0b,stroke-width:1.5px,color:#0f172a
  classDef cv fill:#f0fdfa,stroke:#14b8a6,stroke-width:1.5px,color:#0f172a
  classDef ag fill:#faf5ff,stroke:#a855f7,stroke-width:1.5px,color:#0f172a
  classDef pl fill:#ffffff,stroke:#cbd5e1,color:#0f172a
  %% Dashed grey = designed but not yet implemented. Everything else is built
  %% and exercised by the test suite or the benchmark.
  classDef planned fill:#f8fafc,stroke:#94a3b8,stroke-width:1.5px,stroke-dasharray:6 4,color:#64748b
  class P1,P2,P3 cv
  class AG,VER ag
  class CAM,UI,HUM,TR pl
  class ING,ST planned
